+"""YaRN rope scaling for the dense Qwen3.8-27B CUDA engine (opt-in).
+
+``TENSORFOLD_YARN_FACTOR`` (for example 4) stretches the native window by that factor: the rotary frequencies are
+blended between interpolated and original ones the way transformers' ``_compute_yarn_parameters`` does it, and the
+rotated halves of q and k are scaled by ``0.1 ln(factor) + 1``. A checkpoint whose ``rope_parameters`` already name
+``rope_type: yarn`` is read the same way. Unset, nothing changes: the factor is 1 and the scale 1.0.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+BETA_FAST, BETA_SLOW = 32.0, 1.0
+DENSE = ("qwen3_5", "qwen3_5_text")           # the dense 27B family; its MoE sibling and Flash Next do not read this
+
+
+def applies(text: dict) -> bool:
+    return text.get("model_type") in DENSE and not text.get("num_experts")
+
+
+def scaling(text: dict) -> tuple[float, int]:
+    """(factor, original window): ``TENSORFOLD_YARN_FACTOR`` wins over the checkpoint's own ``rope_parameters``."""
+
+    native = int(text.get("max_position_embeddings") or 0)
+    rope = text.get("rope_parameters") or text.get("rope_scaling") or {}
+    factor, original = 1.0, native
+    if str(rope.get("rope_type") or rope.get("type") or "") == "yarn":
+        factor = float(rope.get("factor", 1.0))
+        original = int(rope.get("original_max_position_embeddings") or native)
+    env = os.environ.get("TENSORFOLD_YARN_FACTOR", "").strip()
+    if env:
+        factor = float(env)
+        original = native
+    if factor < 1.0 or not math.isfinite(factor):
+        raise ValueError(f"TENSORFOLD_YARN_FACTOR: a factor of 1 or more, not {factor}")
+    return factor, original
+
+
+def window(text: dict) -> int:
+    """The window the engine may serve: the checkpoint's, times the factor."""
+
+    native = int(text.get("max_position_embeddings") or 0)
+    if not applies(text) or not native:
+        return native
+    factor, original = scaling(text)
+    return int(original * factor) if factor > 1.0 else native
+
+
+def mscale(factor: float) -> float:
+    return 1.0 if factor <= 1.0 else 0.1 * math.log(factor) + 1.0
+
+
+def inv_freq(dim: int, theta: float, factor: float = 1.0, original: int = 0):
+    """The rotary frequencies of the first ``dim`` dimensions (fp32, ``dim / 2`` of them), YaRN-blended for ``factor`` > 1."""
+
+    import torch
+
+    half = dim // 2
+    pos = theta ** (torch.arange(0, dim, 2, dtype=torch.float64) / dim)
+    extrapolated = 1.0 / pos
+    if factor <= 1.0:
+        return extrapolated.to(torch.float32)
+    interpolated = 1.0 / (factor * pos)
+
+    def correction(rotations: float) -> float:
+        return dim * math.log(original / (rotations * 2 * math.pi)) / (2 * math.log(theta))
+
+    low = max(math.floor(correction(BETA_FAST)), 0)
+    high = min(math.ceil(correction(BETA_SLOW)), dim - 1)
+    if low == high:
+        high += 0.001
+    ramp = ((torch.arange(half, dtype=torch.float64) - low) / (high - low)).clamp(0, 1)
+    keep = 1.0 - ramp                                  # 1: the original frequency (fast rotations), 0: interpolated
+    return (interpolated * (1.0 - keep) + extrapolated * keep).to(torch.float32)
